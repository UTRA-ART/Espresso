		</collision>
	</link>

	<joint name="bottom_lidar_joint" type="fixed">
		<origin xyz="0.664824 0.0 -0.185382" rpy="0 0 0" />
		<parent link="chassis_link" />
		<child link="bottom_lidar_link" />
		<axis xyz="0 0 0" />
	</joint>

